@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true

class ClassificationResultHandler {
  - default_region: str
  - last_result: dict
  + __init__(default_region: str = "Dortmund")
  + initialize(): None
  + handle(classifier_result: dict): dict
  + default_region: str
  + last_result: dict
}

class GuidanceService {
  - repository
  - default_region: str
  - last_guidance: dict
  - last_classification_id
  + __init__(repository, default_region: str = "Dortmund")
  + initialize(): None
  + process(prediction: dict): dict
  + repository
  + default_region: str
  + last_guidance: dict
  + last_classification_id
}

class ResponseComposer {
  - api_version: str
  - last_response: dict
  + __init__(api_version: str = "v1")
  + initialize(): None
  + compose(prediction: dict, processed: dict): dict
  + api_version: str
  + last_response: dict
}

ClassificationResultHandler --> GuidanceService : validated prediction
GuidanceService --> ResponseComposer : processed result
GuidanceService ..> DatabaseManager : repository interface
ResponseComposer --> Frontend : JSON response

note right of GuidanceService
Default region: Dortmund
Label-based guidance lookup
(e.g. "glass jar")
end note
@enduml
